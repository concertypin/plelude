{
    "name": "template-typescript-vite",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "license": "MIT",
    "author": {
        "name": "concertypin",
        "url": "https://github.com/concertypin"
    },
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "files": [
        "dist"
    ],
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./*": {
            "types": "./dist/*/index.d.ts",
            "import": "./dist/*/index.js"
        }
    },
    "scripts": {
        "dev": "vite build --watch",
        "build": "vite build",
        "format": "oxfmt --write .",
        "format:check": "oxfmt --check .",
        "lint:check": "oxlint .",
        "lint": "oxlint . --fix",
        "postinstall": "pnpm exec simple-git-hooks",
        "check": "pnpm run format && pnpm run lint && pnpm run test",
        "test": "vitest run"
    },
    "engines": {
        "node": ">=26"
    },
    "devDependencies": {
        "@concertypin/config": "^0.5.0",
        "@types/node": "^26.6.4",
        "@vitest/coverage-v8": "^5.0.3",
        "cross-env": "^10.1.0",
        "globals": "^17.13.0",
        "oxfmt": "^0.72.0",
        "oxlint": "^1.87.0",
        "oxlint-tsgolint": "^7.0.2003",
        "simple-git-hooks": "^2.14.0",
        "typescript": "~6.0.3",
        "vite": "^8.3.2",
        "vite-plugin-dts": "^5.1.2",
        "vitest": "^5.0.3"
    },
    "packageManager": "pnpm@12.9.1"
}
